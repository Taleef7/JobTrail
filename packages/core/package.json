{
  "name": "@jobtrail/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./text": "./src/text.ts",
    "./schema/*": "./schema/*"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "build": "tsc -p tsconfig.json",
    "gen:schema": "vitest run src/schema-files.test.ts --mode update-schemas",
    "score": "node src/cli/score.ts",
    "baseline": "node src/cli/baseline.ts",
    "legacy-oracle": "node src/cli/legacy-rules-oracle.ts"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "fast-check": "^4.10.2",
    "typescript": "~6.0.3",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "files": [
    "src",
    "schema"
  ]
}
