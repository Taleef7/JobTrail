# Secrets — never commit (ml/.env holds the Gemini key)
.env
.env.*
!.env.example

# Node / pnpm
node_modules/
.pnpm-store/
*.tsbuildinfo
dist/
.vercel/

# Expo / React Native
.expo/
expo-env.d.ts
web-build/
/apps/mobile/ios/
/apps/mobile/android/
*.jks
*.keystore
*.p8
*.p12
*.key
*.mobileprovision

# Python (ml/)
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# Model weights & large run artifacts (published to Hugging Face, not git)
*.gguf
*.safetensors
*.bin
ml/checkpoints/
ml/runs/tmp/

# Testing
coverage/

# Local tooling
.opencode/
.playwright-mcp/
.idea/
.vscode/
*.swp
.DS_Store

# Logs
*.log

# Local agent/editor config
.claude/

# Score reports in evidence are regenerated by ml/scripts/score_run.py; their SHA-256
# is recorded in the evidence checks.json instead (#72)
evidence/*/runs/*/report.json
# Score reports under results/runs are rebuilt by the scorer from the committed predictions;
# results/summary.json records their SHA-256 (#73)
results/runs/**/report.json
results/runs/**/*.report.json
